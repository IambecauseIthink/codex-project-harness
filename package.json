{
  "name": "codex-project-harness",
  "version": "0.1.0",
  "description": "Local, evidence-driven project harness for Codex",
  "type": "module",
  "bin": {
    "harness": "dist/cli.js"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "build": "tsc -p tsconfig.build.json && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "node scripts/codex-probe.mjs",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "start": "node dist/cli.js serve",
    "prepack": "npm run build",
    "test:live:product": "tsx scripts/live-acceptance.ts",
    "test:live:web": "tsx scripts/live-web.ts",
    "test:live:change": "tsx scripts/live-change.ts",
    "format": "prettier --write src tests scripts/*.ts docs/*.md README.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@xyflow/react": "^12.9.0",
    "elkjs": "^0.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.5"
  },
  "private": true
}
